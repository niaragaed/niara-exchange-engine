# Niara Exchange order service: environment variables. TESTNET ONLY.
# Copy to .env (git-ignored), fill in, and run `npm start` (node --env-file=.env).
# Every value here is server-only. Never put any of them in a NEXT_PUBLIC_*
# variable or a frontend: the service refuses to start if one looks like it.

# Postgres connection of the Supabase project (niara-exchange-dev). SECRET: it
# holds the database password.
# - Direct or session-mode connection (port 5432). Never the transaction pooler
#   (port 6543): it cannot hold the single-instance advisory lock (refused).
# - The login role must be a member of service_role: every write runs as
#   service_role (set local role), with the migration's grants.
# - TLS: verify the server against Supabase's CA certificate (dashboard,
#   Database settings, SSL), saved outside the repo.
DATABASE_URL=postgresql://LOGIN_ROLE:PASSWORD@DB_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/path/outside/repo/supabase-ca.crt

# Not used by this service (it talks to Postgres directly). Listed so that, if a
# server component ever needs it, it lives here and never in NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=

# HTTP listener. Keep it on localhost behind a reverse proxy that terminates TLS.
HOST=127.0.0.1
PORT=8787

# Abuse limits.
MAX_BODY_BYTES=16384
MAX_OPEN_ORDERS_PER_WALLET=50

# Matching and housekeeping (seconds).
SETTLEMENT_MARGIN_SECS=60
EXPIRY_SWEEP_SECS=30
MARKET_REFRESH_SECS=60

# Solana DEVNET RPC (anything else is refused by genesis hash). Optional: the
# default is the public devnet RPC. A private RPC URL can hold an API key: it is
# then a secret, never logged.
# SOLANA_RPC_URL=

# On-chain delegate checks (spec §3.5) before matching and before settling: on|off.
DELEGATE_CHECK=on

# Settlement worker (runs inside the service process): Solana devnet, plus the
# EVM testnets of EVM_SETTLEMENT_CHAINS below.
# SOLANA_OPERATOR_KEYPAIR is the PATH of the settlement operator's keypair file,
# outside this repository, mode 600 (never the key itself). Required while the
# worker is on.
WORKER_ENABLED=on
SOLANA_OPERATOR_KEYPAIR=/home/USER/.config/niara-exchange/devnet/settlement-operator.json
WORKER_POLL_SECS=5
WORKER_MAX_ATTEMPTS=6
SETTLE_DEADLINE_MARGIN_SECS=90

# EVM TESTNETS (Base Sepolia, Robinhood Chain testnet, Tempo testnet; HyperEVM once
# deployed). Contract addresses, gas rules and lot sizes are in
# config/evm-testnets.json; a chain settles only once that file marks it reviewed.
# The node's chain id is checked on start.
# Comma-separated chains the worker settles on and checks allowances on; empty = none.
EVM_SETTLEMENT_CHAINS=
# PATH of the settlement operator's encrypted Foundry keystore (niara-contracts uses
# ~/.foundry/keystores on Windows; from WSL that is /mnt/c/Users/<you>/.foundry/keystores).
# Outside this repository. Required while EVM_SETTLEMENT_CHAINS is set.
EVM_OPERATOR_KEYSTORE=/mnt/c/Users/USER/.foundry/keystores/niara-evm-operator
# Its password. SECRET: never logged, never in NEXT_PUBLIC_*.
# EVM_OPERATOR_KEYSTORE_PASSWORD=
# RPCs, same names as niara-contracts' .env. Optional: the default is each chain's
# public RPC. A private URL can hold an API key: it is then a secret, never logged.
# BASE_SEPOLIA_RPC_URL=
# ROBINHOOD_TESTNET_RPC_URL=
# TEMPO_TESTNET_RPC_URL=
# HYPEREVM_TESTNET_RPC_URL=

# scripts/e2e-evm.ts only (not the service): passwords of the demo investor keystores
# niara-evm-investor-a (buyer) and niara-evm-investor-b (seller). SECRETS.
# EVM_INVESTOR_A_KEYSTORE_PASSWORD=
# EVM_INVESTOR_B_KEYSTORE_PASSWORD=

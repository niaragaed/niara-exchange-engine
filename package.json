{
  "name": "niara-exchange-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain side of the Niara Exchange (testnet only): order intents, matching engine, settlement worker.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:engine": "vitest run test/engine",
    "test:intents": "vitest run test/intents",
    "start": "node --env-file=.env src/service/main.ts",
    "start:railway": "node src/service/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@noble/ed25519": "3.2.0",
    "@scure/base": "2.4.0",
    "@solana/web3.js": "1.98.4",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
